# Configurações do Sistema de Mensagens Seguras
# ECDH + Ed25519/TOFU + HKDF + AES-128-GCM

# Porta do servidor Node.js (WebSocket)
NODE_PORT=6666

# URL do servidor Node.js
NODE_URL=http://localhost:6666

# Configurações de debug
DEBUG_ECDH=false
DEBUG_IDEA=false

# Configurações de desenvolvimento
NODE_ENV=development
